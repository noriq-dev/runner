{
  "name": "@noriq-dev/runner",
  "version": "0.19.0",
  "description": "A small, durable agent-guided job harness for Noriq",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "noriq",
    "agents",
    "claude",
    "codex",
    "runner",
    "daemon",
    "cli"
  ],
  "bin": {
    "noriq-runner": "dist/cli.js"
  },
  "files": [
    "dist",
    "examples"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "prebuild": "node scripts/clean-dist.mjs",
    "build": "tsc -p tsconfig.build.json --noEmit && esbuild src/cli.ts src/control-mcp.ts --bundle --platform=node --format=esm --target=node22 --external:ws --outdir=dist --sourcemap --legal-comments=none && node scripts/smoke-built.mjs",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test",
    "dogfood:git": "tsx scripts/dogfood-git.mts",
    "dogfood:live-agents": "tsx scripts/dogfood-live-agents.mts",
    "vendor:shared": "node scripts/vendor-shared.mjs",
    "vendor:check": "node scripts/vendor-check.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noriq-dev/runner.git"
  },
  "bugs": {
    "url": "https://github.com/noriq-dev/runner/issues"
  },
  "homepage": "https://github.com/noriq-dev/runner#readme",
  "dependencies": {
    "smol-toml": "^1.3.1",
    "ws": "^8.21.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.13",
    "@noriq-dev/shared": "file:./vendor/noriq-shared",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.2",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
