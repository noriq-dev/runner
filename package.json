{
  "name": "@noriq-dev/runner",
  "version": "0.1.0-rebuild.0",
  "description": "A small, durable agent-guided job harness for Noriq",
  "license": "MIT",
  "type": "module",
  "bin": {
    "noriq-runner": "./dist/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test",
    "vendor:shared": "node scripts/vendor-shared.mjs",
    "vendor:check": "node scripts/vendor-check.mjs"
  },
  "dependencies": {
    "smol-toml": "^1.3.1",
    "ws": "^8.21.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@noriq-dev/shared": "file:./vendor/noriq-shared",
    "@biomejs/biome": "^2.3.13",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.19.2",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
