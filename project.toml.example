# Example COMMITTED per-repo marker for the Noriq Runner.
#
# `noriq-runner init-project` writes one of these for you, from inside the repo — this
# file is the annotated reference for everything it does not ask about.
#
# Copy to `.noriq/project.toml` at the root of a repo you want the Runner to work.
# UNLIKE runner.toml (machine-local), this file IS committed — it travels with the
# repo and is team-shareable. It carries no secrets. Validated against
# @noriq-dev/shared's ProjectManifest when the daemon discovers it.

# Committed, portable project identifier (1–8 chars). Resolved to a prj_… id per
# configured server at registration, so the checkout stays portable across Noriq
# instances and forks without editing this file. Must match a project KEY you can
# reach on the server (the key you see in the dashboard, e.g. ACME).
key = "ACME"

# Optional: lock this repo's work to one BOARD within the project (RUN-71) — the same
# idea as `key`, one level down. A project can host several repos; without this, every
# task this repo's agents create lands on the project's default board. A board NAME
# (matched case-insensitively), not an id, for the same reason `key` is not a prj_… id:
# ids are server-local and this file is committed. A name the server can't resolve is
# shown as unresolved in the dashboard and simply doesn't bind — the repo stays fully
# dispatchable. A landing default, not a fence: the dispatch form filters its anchor
# list to this board, and an agent explicitly told another board is not blocked.
# board = "Runner"

# Default agent driver for this repo. Omit (or null) to use the runner's default.
# One of: "claude" | "codex".
tool = "claude"

# The repo's main branch, if the daemon should reference it. Optional.
defaultBranch = "main"

# ── Canonical repository identity (Project Memory §6, RUN-208) ───────────────
# Optional. A short, portable, project-local SLUG — never a path, never this daemon's own
# local checkout id — that stays stable across re-clones and machine changes, which a
# checkout id is by definition not. It is what lets a memory, an episode, or an index
# generation say "this came from repository X" in a way that survives you moving the repo
# to a new laptop.
#
# TOP-LEVEL, not a `[repository]` table, despite what that might suggest: the shared wire
# contract (vendor/noriq-shared/src/manifest.ts) declares `repositoryKey` as a plain field
# on the manifest, and this file always matches the schema's own spelling, not the other
# way around.
#
# Rules, checked with the same validator the server uses (`RepositoryKey` in
# vendor/noriq-shared/src/memory.ts) — a malformed value is a VISIBLE failure (logged,
# reported to the server as null), never silently rebound to `key`, the repo's directory
# name, or the daemon's own internal repo id:
#   - letters, digits, `.`, `_`, `-` only, and must START with a letter
#   - 1–64 characters
#   - must NOT start with `ckt_` — that prefix is reserved for this daemon's own
#     runner-local checkout ids (a different, opaque id space you never write by hand)
#
# Blank = no Project Memory association for this repo: nothing about it is ever cited as
# evidence, and no index generation can be attributed to it.
# repositoryKey = "noriq-runner"

# ── Repository indexing (Project Memory §7) ───────────────────────────────────
# Optional, and OFF unless you say otherwise: a repo you never opt in here never has its
# files read for the project memory graph. There is no inference from what the repo
# contains, no default-on, and an `[index]` table present with `enabled` left unset is
# still OFF — the same "opt-in, never assumed" posture as `[land].autoPush` and
# `[permissions.*].auto` elsewhere in this file.
#
# Two schemas share this one table, and the split is deliberate (VENDORED-CONTRACT.md):
#   enabled / include / exclude   — the WIRE contract (vendor/noriq-shared's `IndexSpec`).
#                                    These decide WHETHER and WHAT SCOPE; they can, in
#                                    principle, matter to the server some day.
#   everything else below         — this DAEMON's own execution posture. These never
#                                    cross the wire; only this runner reads them.
#
# [index]
# enabled = true                 # OFF (default) unless this is explicitly true.
#
# include = ["src/**", "docs/**"]   # Glob patterns, relative to the repo root. Empty
# exclude = ["**/*.generated.*"]    # (default) means "everything not excluded". Every
#                                    # glob is CONFINED to the repo root at config load —
#                                    # an absolute path or one that escapes via `..` (e.g.
#                                    # "../../.ssh/**") is refused and named in the log; a
#                                    # bad glob turns indexing off for this repo without
#                                    # touching anything else the daemon does with it.
#
# excludeDefaults = true          # ON by default — layers a conservative, machine-wide exclude
#                                  # for committed generated content UNDER whatever `exclude`
#                                  # above already says (RUN-262): today, package/lockfiles
#                                  # (`package-lock.json`, `npm-shrinkwrap.json`, `yarn.lock`,
#                                  # `pnpm-lock.yaml`) and a committed `node_modules/`. These are
#                                  # machine-regenerated bookkeeping no agent will ever cite, and
#                                  # `package-lock.json` alone was measured hitting the per-file
#                                  # entity cap and spending a fifth of a small repo's entity
#                                  # budget on it. This is a QUALITY default, NOT a security
#                                  # floor like the sensitive-file deny list below `[index]`'s
#                                  # reach — set `excludeDefaults = false` if this repo genuinely
#                                  # wants a defaulted-out path (e.g. its own lockfile) indexed;
#                                  # nothing here can be turned into a second non-overridable
#                                  # floor. A file dropped by this default reports a distinct
#                                  # `excluded-default` reason (vs. `excluded` for the list
#                                  # above), so a missing file is diagnosable as "the daemon
#                                  # assumed that" rather than "I wrote that exclude".
#
# languages = ["typescript", "javascript", "markdown", "json", "toml"]
#                                 # Which file types are actually read. This is the full
#                                 # initial set (also the default when the key is
#                                 # omitted) — narrow it if this repo's index should only
#                                 # cover a subset. An unrecognized name REFUSES indexing
#                                 # for this repo (named in the log) rather than silently
#                                 # skipping that language: a typo here should not read as
#                                 # "configured" while indexing nothing for it.
#
# contentMode = "full"           # "full" (default) stores the read file content, bounded
#                                 # by the size knobs below, for later phases to parse.
#                                 # "metadata" records only path/language/symbol facts —
#                                 # never raw source text — for a repo willing to be
#                                 # indexed but not to have its source land in the memory
#                                 # store.
#
# maxFiles = 20000               # Bounded size/count controls — daemon POSTURE, not wire
# maxFileBytes = 1000000         # contract, so raising them never needs a server change.
# maxTotalBytes = 500000000      # Defaults: 20k files and 500 MB total keep a large
#                                 # monorepo bounded without truncating an ordinary repo;
#                                 # 1 MB per file excludes generated/minified/binary-shaped
#                                 # files without excluding ordinary hand-written source.
#
# readDeadlineMs = 120000        # Wall-clock ceiling on ONE indexing pass (2 minutes),
#                                 # so a slow or huge filesystem walk cannot hang the
#                                 # daemon indefinitely.
#
# pollIntervalMinutes = 60       # Reindex cadence. PARSED ONLY today — nothing schedules
#                                 # on it yet (that is a later phase); hourly is the
#                                 # sensible default once something does.
#
# An invalid value anywhere in this table (a negative bound, an unrecognized key, a
# non-numeric cadence, a glob that escapes the root) refuses INDEXING for this repo only,
# with an `error`-level log naming the offending key — it never takes discovery or
# dispatch down with it. Indexing is an enrichment; the run path is the product.

# ── What this repo tells every agent about itself (RUN-128/129) ──────────────
# Optional — but NOT inert when omitted: if this repo has a CLAUDE.md or AGENTS.md
# at its root, the daemon inlines it into every scope/build brief by default. Those
# files are written to steer a coding agent, and ignoring them meant our agents
# worked from less than the repo had already written down. Declaring
# `requiredReading` below REPLACES that fallback, and `agentInstructions` decides
# what happens when you declare no reading of your own (RUN-155):
#
#   inline  (default) reproduce the file in the brief — right for most repos
#   name              say it exists and let the agent read it, for a large file
#                     aimed at humans as much as agents, where pre-loading costs
#                     more context than reading the part it needs would
#   off               say nothing at all
#
# It governs only the fallback: a declared `requiredReading` is always inlined.
#
# Before this existed, an agent's brief carried the task and nothing else, so
# every run spent its most valuable early context re-deriving the same facts —
# and derived them slightly differently each time. This is the repo saying them
# once, in the committed marker, so every teammate's runner briefs identically.
#
# Declarative on purpose: PATHS and short steers, never file contents. Paths are
# resolved against the repo root and CONFINED there — a path pointing outside the
# checkout (`../../.ssh/id_rsa`, an absolute path, or an in-repo symlink whose
# target escapes) is refused and logged, never read. A path that simply does not
# exist is logged too: a required-reading list that quietly shrinks to nothing is
# worse than one that was never configured, because the repo goes on believing
# its agents are oriented.
#
# [context]
# # Read before changing anything. Order matters — it is priority: files are
# # inlined in this order until the budget runs out, so put what an agent cannot
# # work without first. The file that crosses the line is included as a marked
# # fragment and the agent is told to read the rest itself; later ones are named.
# # Declaring this list replaces the CLAUDE.md/AGENTS.md fallback described above —
# # including when every path in it fails to resolve (you get warnings, not a
# # silent substitution).
# requiredReading = ["docs/ARCHITECTURE.md", "CLAUDE.md"]
# # Where to start reading the code. Architectural entry points, not an index.
# entryPoints = ["src/daemon.ts", "src/supervisor.ts"]
# # Short, non-negotiable steers. Anything needing a paragraph belongs in a
# # requiredReading document, where it can be maintained as prose rather than
# # rotting in a TOML array.
# conventions = ["ESM only, Node >= 20", "import type for type-only imports"]
#
# # What to do with a CLAUDE.md / AGENTS.md when no requiredReading is declared.
# agentInstructions = "inline"   # or "name", or "off"

# ── Default model + reasoning effort, per kind (RUN-33) ──────────────────────
# Optional, and per KIND on purpose: that is where the difference actually lives.
# A scope run is exploration and judgment, a build is execution, a verify is
# adversarial reasoning — one repo-wide value gets at least one of them wrong.
# Say it once here instead of relying on whoever dispatches to remember.
#
# Precedence, most specific first:
#   the dispatch (a human chose, for that run)
#     → these defaults (this repo, this kind)
#       → whatever the tool itself defaults to
#
# Both fields are optional and independent — wanting a higher effort while
# inheriting the tool's model is perfectly normal, and so is the reverse.
#
#   model  — the vendor's own name, passed through. Deliberately not validated
#            against a list: model names change constantly, and a stale allowlist
#            would reject one your CLI supports fine. A wrong name fails fast.
#   effort — "low" | "medium" | "high" | "xhigh" | "max". Tool-agnostic INTENT;
#            each driver maps it. Codex's scale tops out at its own "high", so
#            "xhigh"/"max" clamp there rather than erroring mid-run.
#
# [defaults.scope]
# model = "claude-opus-4-8"    # exploration + judgment: worth the strong model
# effort = "high"
#
# [defaults.build]
# model = "claude-sonnet-5"    # execution against an approved task
# effort = "medium"
#
# [defaults.verify]
# effort = "xhigh"             # adversarial reasoning; inherit the tool's model
#
# Or spell any of these as one agent COORDINATE (RUN-113) — <tool>.<model>.<effort>,
# a dotted model version written with underscores (opus-4_8 = opus-4.8). When set,
# `agent` wins over the model/effort pair above:
#
# [defaults.build]
# agent = "claude.opus-4_8.high"
#
# [defaults.scope]
# agent = "codex.gpt-5_6-sol.high"   # a different vendor, in one line

# ---------------------------------------------------------------------------
# Custom workflows (RUN-119/192) — named variants of a built-in run kind.
# ---------------------------------------------------------------------------
# A workflow inherits the security POSTURE of its `base` (one of scope/build/verify)
# and cannot escape it — a scope-based workflow is read-only because scope is, no
# matter what. What it varies is the PROMPT the agent is briefed with. The three
# built-ins are always available and need no declaration. Project definitions win
# over ~/.noriq/workflows definitions and bundled names. The full shape-specific
# variable dictionary is documented in prompts/README.md; common values include
# {{identity}}, {{brief}}, {{anchor}}, {{context}}, {{projectKey}}, and task fields.
#
# A larger definition can instead live at `.noriq/workflows/docs.toml` (the
# filename is the workflow name), with a prompt beside it:
#
#   base = "scope"
#   prompt = { file = "docs-plan.md" }
#
# Machine-only definitions use the same shape under ~/.noriq/workflows/. Files and
# their prompt bytes are re-read at dispatch; prompt paths are confined to the repo
# or the user workflow directory respectively.
#
# [workflow.docs]
# base = "scope"                       # read-only, produces a plan — like scope
# prompt = "Survey {{brief}} and write a docs-update plan. Do NOT change code."
#
# [workflow.hotfix]
# base = "build"                       # writes + is gated by verify/land — like build
# prompt = "Ship the smallest safe fix for {{brief}}. {{anchor}}"
#
# ── Per-workflow stages + agent coordinates (RUN-193) ────────────────────────
# A workflow may also declare its PIPELINE and, per stage, the AGENT COORDINATE
# that stage's actor runs under. A coordinate picks a MODEL, never a posture —
# the write floor and stage clamp are runner-side and unreachable here — so a repo
# can plan with one model, build with a cheaper one, and be judged by a third.
#
# Two spellings of one declaration (TOML cannot put an array and a table on one
# key); the declared SET is the array's entries or the table's keys, so declaring
# only [stages.review] DECLINES the other optional stages (review, integrate):
#
#   stages = ["plan", "execute", "review"]        # names only, every stage inherits
#
#   [workflow.audit]
#   base = "build"
#   [workflow.audit.stages.review]
#   agent = "codex.gpt-5_6-sol.high"   # judge this build on a stronger, other-vendor model
#   [workflow.audit.stages.execute]
#   agent = "claude.opus-4_8.medium"   # …while the builder runs cheaper
#
# Addressable stage keys: plan, plan-check, pattern-map, execute, review (and, in
# a `.noriq/workflows/<name>.toml` file, `[stages.<name>]`). `plan-check` selects
# the plan-checker's model without being a pipeline stage. The coordinate sits at
# the TOP of each stage's ladder — above the dispatch coordinate and every manifest
# field (`[defaults.<kind>]`, `[verify.agent]`). Only optional stages are declinable;
# order is always the machine's; an unknown name or malformed coordinate is ignored
# with a warning, never a gate.

# ── The FILE form: a two-workflow worked example (RUN-192/193) ────────────────
# A definition too big for an inline `[workflow.<name>]` table lives in its own
# file at `.noriq/workflows/<NAME>.toml` — the FILENAME is the workflow name, so
# the file carries `base` / `prompt` / `stages` at the TOP LEVEL, with no
# `[workflow.<name>]` wrapper. A dispatch selects it by name (`workflow = "plan"`);
# a project file wins over an inline `[workflow.<name>]` table, which wins over a
# `~/.noriq/workflows/<name>.toml` machine-local file, which wins over the bundled
# scope/build/verify name.
#
# The two files below are one repo dogfooding its own pipeline: PLAN the work on a
# cheap-but-careful model, BUILD it on a second vendor, and JUDGE the build on a
# third. Each `[stages.<name>]` picks only the MODEL its actor runs — the write
# floor and stage clamp are runner-side and unreachable from here (RUN-118/132), so
# no coordinate can move a posture.
#
# READ THIS BEFORE COPYING: a `[stages.…]` block is a RESTRICTIVE SET, not a set of
# per-stage overrides. The moment a file declares ANY `[stages.<name>]`, the stages
# that run become exactly {mandatory ∪ the optional ones you listed} ∩ {stages this
# base runs} — so an OPTIONAL stage you leave out is DECLINED, and a stage the base
# does not run is dropped even if you name it. Mandatory stages (prepare, execute,
# verify, settle) always run; the OPTIONAL, declinable ones are plan, plan-check,
# pattern-map, review, integrate. A `scope` base runs NONE of those optional stages
# (they all require a producing workflow), so a scope run's own planner is its
# `execute` stage — which is why plan/plan-check are illustrated under `build` below,
# not under `plan`.
#
#   ── .noriq/workflows/plan.toml ──   dispatch as  workflow = "plan"
#   base = "scope"                        # read-only; produces a plan, not a diff.
#                                         # scope has no optional stages, so listing
#                                         # execute declines nothing.
#   [stages.execute]
#   agent = "claude.fable-5.high"         # the scope run's planner runs on Fable
#
#   ── .noriq/workflows/build.toml ──  dispatch as  workflow = "build"
#   base = "build"                        # writes; verify + review gate it, and it
#                                         # lands only when [land] is configured.
#                                         # Every optional stage kept below MUST be
#                                         # listed, or declaring any one declines it.
#   [stages.plan]
#   agent = "claude.fable-5.high"         # planner drafts the spec (task w/o a spec)
#
#   [stages.plan-check]
#   agent = "codex.gpt-5_6-sol.high"      # a second vendor audits that spec
#
#   [stages.pattern-map]                  # kept; no agent = inherit the run's model
#
#   [stages.execute]
#   agent = "codex.gpt-5_6-sol.medium"    # the builder writes the diff on Codex
#
#   [stages.review]
#   agent = "claude.opus-4_8.high"        # Opus judges it — a third model
#
#   [stages.integrate]                    # kept, so a passing build can still land
#
# Two things a copier needs to get right:
#   • Coordinate spelling — a dotted model version writes its dots as underscores,
#     so `opus-4_8` means opus-4.8 and `gpt-5_6-sol` means gpt-5.6-sol; a dashed id
#     with no dots (`fable-5`) is written verbatim. Every string above parses under
#     the coordinate grammar in src/agent-coordinate.ts.
#   • Naming a stage's MODEL does not turn the stage ON. `plan-check` and `review`
#     both run only when this project.toml also carries a `[verify.agent]` section
#     (see below) — a review coordinate with no `[verify.agent]` names a reviewer
#     that never spawns; `integrate` lands only when `[land]` is configured. The
#     deterministic `[verify] cmd` floor is a separate, always-on, zero-token gate
#     and is left exactly as it is here — the review coordinate does not replace it.

# ── The verify stage: a CHOICE (RUN-61) ──────────────────────────────────────
# What gates a BUILD run after its agent exits clean, decided by what this
# section contains:
#
#   omit [verify] entirely  → no verify stage. The diff still lands as a review
#                             diff on its branch — a human is the gate.
#   cmd = "…"               → the deterministic floor: the daemon runs it (zero
#                             tokens) in the Run's worktree; non-zero exit or
#                             timeout GATES the run, and the output goes back to
#                             the live agent to fix (bounded, K=2).
#   [verify.agent]          → the inline reviewer: a FRESH agent — never the one
#                             that wrote the code — reviews the diff read-only
#                             against the task intent and files a verdict; a FAIL
#                             report is handed back to the builder to fix, then a
#                             fresh reviewer looks again (bounded by maxRounds).
#   both                    → floor first (cheap screen), then the reviewer.
#
# A [verify] section with NEITHER is a config error, refused at parse — silence
# must not read as a gate that isn't there.
#
# ---------------------------------------------------------------------------
# [setup] — what the DAEMON runs to make a fresh workspace usable, before any
# agent starts (RUN-202). Optional; omit it and nothing changes.
#
# Why it exists: every run gets its own worktree, and a fresh worktree has no
# node_modules. Without this, the agent's first turns go on discovering that —
# and a read-only reviewer, which may not be allowed to install anything, can
# end up unable to run the suite it was spawned to judge. That is machine work
# at model prices.
#
# The rules, so nothing here surprises you:
#   - Runs after the workspace is leased, before EVERY actor (planner included).
#   - Same credential posture as `verify.cmd`: no push credentials, no Noriq
#     token. These commands are as trusted as your verify command — no more.
#   - FAIL-OPEN. A failing command is reported in the run's transcript and in
#     the agent's brief ("the environment may be incomplete"), and the run goes
#     ahead. Setup is preparation, not a gate; verify still judges the result.
#   - Runs ONCE per workspace: a continuation or a resumed park re-enters an
#     already-bootstrapped tree and skips it. Editing `cmds` re-runs it.
#   - Setup seconds do not count against the run's wall-clock budget, which
#     measures agent time.
#
# [setup]
# cmds = ["npm ci"]        # in order; the first failure stops the rest
# timeoutSeconds = 600     # per COMMAND; raise it for heavy bootstraps

# Put tsc in `cmd`: vitest/esbuild do NOT catch type errors.
[verify]
cmd = "npm run typecheck && npm test"
# timeoutSeconds = 600   # blank = this built-in default; a timeout GATES the run. A [verify]
#                        # key — keep it up here, above [verify.agent], or it binds to nothing.
# maxRounds = 2                  # failing-cmd → fix → re-verify rounds handed back to the LIVE
#                                # agent before the run stops and a human picks it up (RUN-94).
#                                # 0 = a pure gate, no hand-back. Blank = 2.
#
# [verify.agent]                 # the inline reviewer (all fields optional)
# tool = "codex"                 # review on a DIFFERENT driver than the builder (RUN-70) —
#                                # the strongest form of the reviewer's independence: another
#                                # vendor's model judging the work. Blank = the run's driver.
#                                # A tool with no driver on the machine FAILS the gate rather
#                                # than silently reviewing with the builder's own vendor.
# model = "claude-opus-4-8"      # adversarial review is where a STRONGER model than the
#                                # builder's earns its cost. Blank = [defaults.verify], then
#                                # the driver's own default — EXCEPT when `tool` is set: model
#                                # names are vendor-specific, so naming a tool severs the
#                                # [defaults.verify] fallback (name the model here instead).
# effort = "high"                # tool-agnostic intent; falls through regardless of `tool`.
# maxRounds = 2                  # FAIL → fix → re-review rounds before the run stops and a
#                                # human picks it up. 0 = one review, no hand-back.
#
# The reviewer runs under the verify permission profile (read-only, below) on the build's
# worktree, under the run's budget, and holds NO Noriq credential — its whole output is its
# report; the daemon parses the verdict and posts the findings. With [land], the reviewer
# judges intent BEFORE landing; `cmd` still re-runs on the REBASED result (see below).
#
# WHICH SHELL `cmd` RUNS UNDER (RUN-42)
# Unset = the platform's own: `sh` on macOS/Linux, **cmd.exe on Windows**.
#
# That matters because THIS FILE IS COMMITTED: `cmd` travels to teammates on other
# operating systems. `&&` means the same thing in both shells, so the common
# `npm run typecheck && npm test` above is portable — but by luck, not design.
# These are not portable to cmd.exe:
#
#   FOO=1 npm test          # env prefix — sh only
#   npm test 2>&1 | tee f   # redirection/pipes differ
#   npx tsc src/**/*.ts     # globbing is the shell's job on sh, the app's on Windows
#   echo "$HOME"            # $VAR vs %VAR%
#
# If your verify command needs any of that on a mixed-OS team, pin a shell and get
# one behaviour everywhere. Git for Windows ships bash, and this daemon already
# requires git — so `bash` is a safe pin in practice:
#
# shell = "bash"          # a [verify] key, like timeoutSeconds — it belongs above any
#                         # [verify.agent] table you uncomment, or it binds to nothing.
#
# Not the default, because a pin that turns out to be absent fails the gate outright,
# which is worse than cmd.exe handling the common case correctly.

# ── Auto-landing (opt-in) ────────────────────────────────────────────────────
# Where a passing build's diff goes, so you stop approving every run by hand. The
# daemon rebases the run onto `branch`, RE-RUNS [verify] on the rebased result, then
# fast-forwards it in and reaps the run's worktree/branch. Work accumulates on one
# integration branch; you merge it onward into main on your own schedule, reviewing a
# batch instead of clicking through runs.
#
# Verify runs AFTER the rebase on purpose: two runs can each be green at their own fork
# point and broken together — a gate that never sees the combination can't catch it.
#
# The daemon never MERGES into your protected branch — it asks. By default it never pushes
# either, so agent work reaches your disk and nowhere else; `autoPush` below opts it into
# publishing this one branch, and `mergeTarget` then opens a merge request rather than
# merging. The human boundary is approving that merge. See THREAT-MODEL.md.
#
# ⚠️ `branch` has no default and is never inferred. Point it at something push-triggered,
# auto-deploying, or watched by CI and you have handed agents production. Omit this whole
# section and nothing auto-lands — every diff waits on its own branch for you.
# [land]
# branch = "noriq/integration"  # may template <planKey> — "noriq/plan-<planKey>" gives each plan
#                               # its own working branch, which is what makes a merge request mean
#                               # something. A one-off dispatch (no plan) strips it → "noriq/plan".
# onlyWhenVerifyPasses = true   # false = an unverified diff reaches `branch`. Allowed, never assumed.
# resolveConflicts = true       # let the build agent fix MECHANICAL rebase conflicts;
#                               # anything needing a decision still bails to a human.
# allowedBranches = ["feature/**", "wip/*"]
#                               # what a DISPATCH may override `branch` with (globs). OMIT → no
#                               # override: `branch` is the only place runs land here. That default
#                               # is deliberate — otherwise adding this feature would silently make
#                               # every repo writable at `main` by anyone who can dispatch. You and
#                               # whoever clicks dispatch are not always the same person.
# mergeTarget = "main"          # open a merge request from `branch` to this, when the PLAN those
#                               # runs belong to is finished — so a human reviews one coherent
#                               # plan's worth of work, not a click per run. Needs autoPush (a PR
#                               # can't exist without the branch being pushed) and `gh` on PATH.
#                               # The daemon opens it AS YOU. Omit → no merge requests.
#                               # Pair with a per-plan branch: branch = "noriq/plan-<planKey>"
# autoPush = false              # push `branch` to its remote after a landing. DEFAULT FALSE, and
#                               # think before flipping it: with it off, nothing an agent writes
#                               # leaves this machine, and `git log origin/main..main` is your
#                               # "what did the agents do while I wasn't looking?" check. On, an
#                               # agent's diff reaches whatever watches that branch — CI, or a
#                               # deploy. The daemon pushes ONE branch, never --force. See
#                               # THREAT-MODEL.md.

# ── Per-kind permission profiles ─────────────────────────────────────────────
# The security floor per Run kind. Defaults (if omitted) are already safe: scope
# and verify are READ-ONLY, build gets worktree WRITE. No agent ever gets push
# credentials — that's enforced by the daemon and is not expressible here. (Still
# true with [land].autoPush: the DAEMON pushes, after the gate, on the branch the
# gate passed. A build agent running `git push` in its worktree has no credentials
# and no way to get them.)
#   write   : may the agent edit files in its worktree?
#   allow   : extra allowlist rules handed to the driver, e.g. "Bash(npm test:*)".
#             Build needs its bash allowlist here — bare `Bash` is never granted
#             unless you opt the kind into `auto` (below). ENFORCED on Claude
#             (allowedTools); codex gates by sandbox LEVEL, not per command, so
#             these rules do not narrow a codex run.
#   deny    : explicit deny rules. On Claude they outrank everything, INCLUDING auto.
#             On codex they bind nothing, for the same reason `allow` does not — a
#             denied command still runs there. See `mapSandbox` in drivers/codex.ts.
#   auto    : opt this kind into the driver's own AUTO mode (RUN-68) — Claude's
#             bypass-permissions / codex's unsandboxed full access — instead of the
#             curated allowlist. Default false, and the default is the floor; this
#             is the per-kind trust escape hatch for repos the allowlist fits badly.
#
#             What auto does NOT loosen, by design:
#               - `write` survives it: a read-only kind stays read-only (edit-tool
#                 denials on Claude; codex keeps the read-only sandbox — its sandbox
#                 is its only enforcement, so codex auto only changes write kinds).
#               - `deny` still binds.
#               - Push credentials (absent from the env) and the per-kind Noriq tool
#                 floor (enforced by the server's own tool registration) hold regardless.
#             What it DOES give up: the bash allowlist, and — for a write kind — the
#             sandbox confining writes to the worktree. On Claude, bash can also mutate
#             files, so verify-with-auto weakens "the reviewer never edits" to the
#             edit-tools layer. Committed file, deliberate choice. See THREAT-MODEL.md.
#
# THERE IS NO EGRESS KEY, and its absence is deliberate (RUN-88). A `network` key existed here
# for a year — "restricted" | "none" | "full", written into every generated manifest — and no
# driver ever read it: an agent got whatever network the daemon had, whatever the file said.
# The Claude SDK has no egress control to hand it to, and codex could only honour a fraction of
# it, so the key was a firewall-shaped word that stopped nothing. Egress control arrives with
# container-isolated runs (RUN-53) and the key returns then, enforced. Until then the honest
# statement is this paragraph: agents on this daemon have the daemon's network. Gate egress at
# the box (or the container) if you need it gated.
#
# [permissions.build]
# auto = true
[permissions.scope]
write = false

# DEP BOOTSTRAP (RUN-56): each Run gets a FRESH worktree, and a fresh worktree has no
# node_modules — without an install rule, `npm test` is allowed but exits 127 (`tsc:
# command not found`), so the verify gate can never go green for ANY run on the repo.
# Allowlist the ecosystem's PINNED install, not its open-ended one:
#   npm ci      — installs exactly the lockfile (integrity-hashed), refuses on drift,
#                 never edits package.json/lockfile. The agent chooses WHEN, never WHICH.
#   npm install — can add arbitrary packages and rewrite the lockfile. Grant it to build
#                 only if agents changing dependencies is work you actually dispatch.
[permissions.build]
write = true
allow = ["Bash(npm ci:*)", "Bash(npm test:*)", "Bash(npm run build:*)", "Bash(npx tsc:*)"]

[permissions.verify]
write = false
# Verify usually inherits deps from the build worktree it reviews, but a STANDALONE
# verify run starts fresh too. Exact `Bash(npm ci)` (no `:*`) is the safe grant: it
# cannot touch tracked files, so "executes but never edits" holds even on a driver
# whose bash is not confined by the write axis. Never put `npm install` here.
# allow = ["Bash(npm ci)", "Bash(npm test:*)"]
